  "components": {
    "schemas": {
      "AdminKey": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "key_prefix": {
            "type": "string",
            "title": "Key Prefix"
          },
          "is_admin": {
            "type": "boolean",
            "title": "Is Admin"
          },
          "active": {
            "type": "boolean",
            "title": "Active"
          },
          "monthly_credit_limit": {
            "type": "integer",
            "title": "Monthly Credit Limit"
          },
          "calls_this_month": {
            "type": "integer",
            "title": "Calls This Month"
          },
          "credits_this_month": {
            "type": "integer",
            "title": "Credits This Month"
          },
          "last_used_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "key_prefix",
          "is_admin",
          "active",
          "monthly_credit_limit",
          "calls_this_month",
          "credits_this_month",
          "last_used_at",
          "created_at"
        ],
        "title": "AdminKey"
      },
      "AdminUsage": {
        "properties": {
          "period_start": {
            "type": "string",
            "format": "date-time",
            "title": "Period Start"
          },
          "calls": {
            "type": "integer",
            "title": "Calls"
          },
          "credits": {
            "type": "integer",
            "title": "Credits"
          },
          "cache_hits": {
            "type": "integer",
            "title": "Cache Hits"
          },
          "keys_used": {
            "type": "integer",
            "title": "Keys Used"
          },
          "fast_calls": {
            "type": "integer",
            "title": "Fast Calls"
          },
          "deep_calls": {
            "type": "integer",
            "title": "Deep Calls"
          },
          "active_keys": {
            "type": "integer",
            "title": "Active Keys"
          },
          "daily": {
            "items": {
              "$ref": "#/components/schemas/DailyUsage"
            },
            "type": "array",
            "title": "Daily"
          }
        },
        "type": "object",
        "required": [
          "period_start",
          "calls",
          "credits",
          "cache_hits",
          "keys_used",
          "fast_calls",
          "deep_calls",
          "active_keys",
          "daily"
        ],
        "title": "AdminUsage"
      },
      "CreateKeyRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "monthly_credit_limit": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100000000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Monthly Credit Limit"
          },
          "is_admin": {
            "type": "boolean",
            "title": "Is Admin",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CreateKeyRequest"
      },
      "CreatedKey": {
        "properties": {
          "key": {
            "$ref": "#/components/schemas/AdminKey"
          },
          "api_key": {
            "type": "string",
            "title": "Api Key",
            "description": "The plaintext key. Returned once; only a hash is stored."
          }
        },
        "type": "object",
        "required": [
          "key",
          "api_key"
        ],
        "title": "CreatedKey"
      },
      "DailyUsage": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date"
          },
          "calls": {
            "type": "integer",
            "title": "Calls"
          },
          "credits": {
            "type": "integer",
            "title": "Credits"
          },
          "deep_credits": {
            "type": "integer",
            "title": "Deep Credits"
          }
        },
        "type": "object",
        "required": [
          "date",
          "calls",
          "credits",
          "deep_credits"
        ],
        "title": "DailyUsage"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Query"
          },
          "objective": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Objective",
            "description": "What the agent is trying to accomplish. Used to rank and excerpt results."
          },
          "mode": {
            "type": "string",
            "enum": [
              "fast",
              "deep"
            ],
            "title": "Mode",
            "default": "fast"
          },
          "max_results": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Max Results",
            "default": 5
          },
          "max_chars_per_result": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 100.0,
            "title": "Max Chars Per Result",
            "default": 2000
          },
          "time_range": {
            "type": "string",
            "enum": [
              "day",
              "week",
              "month",
              "year",
              "any"
            ],
            "title": "Time Range",
            "default": "any"
          },
          "include_domains": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Include Domains"
          },
          "exclude_domains": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Exclude Domains"
          },
          "include_raw_content": {
            "type": "boolean",
            "title": "Include Raw Content",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest"
      },
      "SearchResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            },
            "type": "array",
            "title": "Results"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "query",
          "results",
          "usage",
          "latency_ms"
        ],
        "title": "SearchResponse"
      },
      "SearchResult": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "excerpts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Excerpts",
            "description": "Passages most relevant to the query and objective. Total length <= max_chars_per_result."
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content",
            "description": "Cleaned page text as markdown, truncated to max_chars_per_result. Only in deep mode with include_raw_content=true."
          },
          "fetched_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fetched At"
          },
          "fetch_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fetch Status",
            "description": "Deep mode only. 'ok', or why the page could not be read (e.g. timeout, http_403, robots_disallowed, blocked:non_public_address, empty_content). When not 'ok', excerpts fall back to the search snippet."
          }
        },
        "type": "object",
        "required": [
          "title",
          "url",
          "domain",
          "score",
          "excerpts"
        ],
        "title": "SearchResult"
      },
      "UpdateKeyRequest": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "monthly_credit_limit": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100000000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Monthly Credit Limit"
          }
        },
        "type": "object",
        "title": "UpdateKeyRequest"
      },
      "Usage": {
        "properties": {
          "credits": {
            "type": "integer",
            "title": "Credits"
          }
        },
        "type": "object",
        "required": [
          "credits"
        ],
        "title": "Usage"
      },
      "UsageSummary": {
        "properties": {
          "key_name": {
            "type": "string",
            "title": "Key Name"
          },
          "key_prefix": {
            "type": "string",
            "title": "Key Prefix"
          },
          "period_start": {
            "type": "string",
            "format": "date-time",
            "title": "Period Start",
            "description": "Start of the current billing month, UTC."
          },
          "calls": {
            "type": "integer",
            "title": "Calls"
          },
          "credits_used": {
            "type": "integer",
            "title": "Credits Used"
          },
          "credit_limit": {
            "type": "integer",
            "title": "Credit Limit"
          }
        },
        "type": "object",
        "required": [
          "key_name",
          "key_prefix",
          "period_start",
          "calls",
          "credits_used",
          "credit_limit"
        ],
        "title": "UsageSummary"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
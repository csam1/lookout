# API keys live in Postgres now. Create one with: websearch create-key --name <caller>

WEBSEARCH_DATABASE_URL=
WEBSEARCH_REDIS_URL=
WEBSEARCH_SEARCH_PROVIDER=searxng
WEBSEARCH_SEARXNG_BASE_URL=http://localhost:8080

# Deep mode: how long a request waits for pages before answering with what it has.
WEBSEARCH_DEEP_DEADLINE_SECONDS=3.0
# Per-page limit; pages that miss the deadline keep loading in the background up to this.
WEBSEARCH_FETCH_TIMEOUT_SECONDS=5.0
WEBSEARCH_RESPECT_ROBOTS_TXT=true

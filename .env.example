# API keys live in Postgres. Create one with: lookout create-key --name <caller>

# Defaults point at the Docker Compose services. Uncomment to override.
# LOOKOUT_DATABASE_URL=postgresql+asyncpg://websearch:websearch@localhost:5432/websearch
# LOOKOUT_REDIS_URL=redis://localhost:6379/0

# Search provider: "searxng" (real, free, self-hosted) or "fake" (tests/dev).
LOOKOUT_SEARCH_PROVIDER=searxng
LOOKOUT_SEARXNG_BASE_URL=http://localhost:8080

# Deep mode: how long a request waits for pages before answering with what it has.
LOOKOUT_DEEP_DEADLINE_SECONDS=3.0
# Per-page limit; pages that miss the deadline keep loading in the background up to this.
LOOKOUT_FETCH_TIMEOUT_SECONDS=5.0
LOOKOUT_RESPECT_ROBOTS_TXT=true
